      }).then(function (r) { return r.json().then(function (j) { if (!r.ok) throw j; return j; }); })
        .then(function () {
          atcMsg.innerHTML = 'Added to cart \u2713 &nbsp;<a href="' + root_ + 'cart">View cart</a>';
          atcMsg.hidden = false;
          document.dispatchEvent(new CustomEvent('zy:vto:added', { detail: { variantId: id } }));
        })
        .catch(function (j) {
          atcMsg.textContent = (j && j.description) || 'Could not add to cart. Please use the main Add to cart button.';
          atcMsg.hidden = false;
        })
        .then(function () { atc.disabled = false; });
    });
  }

  window.__zyVTO = {
    detect: detect,
    extractImage: extractImage,
    scan: function () {
      document.querySelectorAll('body > [data-zy-modal][data-zy-owner]').forEach(function (m) {
        if (!document.getElementById(m.getAttribute('data-zy-owner'))) m.remove();
      });
      document.querySelectorAll('[data-zy-vto]').forEach(init);
    }
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', window.__zyVTO.scan);
  else window.__zyVTO.scan();
  document.addEventListener('shopify:section:load', window.__zyVTO.scan);
})();
</script>
{%- endunless -%}
